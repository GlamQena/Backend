BACKEND_PORT=8080
FRONTEND_PORT=3000

# ============ SECRETS ============
ACCESS_TOKEN_SECRET=your_access_secret
REFRESH_TOKEN_SECRET=your_refresh_secret

# ============ ACCESS TOKEN (shared by web & mobile) ============
ACCESS_TOKEN_EXPIRY=15m
ACCESS_TOKEN_MS=900000

# ============ REFRESH TOKEN — WEB ============
# Normal (no "remember me"): 7 days
REFRESH_TOKEN_NORMAL_EXPIRY=7d
REFRESH_TOKEN_NORMAL_MS=604800000
# Remembered: 30 days
REFRESH_TOKEN_REMEMBERED_EXPIRY=30d
REFRESH_TOKEN_REMEMBERED_MS=2592000000

# ============ REFRESH TOKEN — MOBILE ============
# Mobile keeps users logged in until explicit logout:
# Normal: 1 year, Remembered: 2 years
REFRESH_TOKEN_MOBILE_NORMAL_EXPIRY=365d
REFRESH_TOKEN_MOBILE_NORMAL_MS=31536000000
REFRESH_TOKEN_MOBILE_REMEMBERED_EXPIRY=730d
REFRESH_TOKEN_MOBILE_REMEMBERED_MS=63072000000

RATE_LIMIT_WINDOW_MS=900000 #15min
RATE_LIMIT_MAX_REQUESTS=100